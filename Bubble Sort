#Sorting using Bubble Sort
def sort_fun(lst,order):
    n=len(lst)
#bubble sort
    for i in range(n):
        for j in range(0,n-i-1):

            #ascending
            if order=="ascending" and lst[j]>lst[j+1]:
                lst[j],lst[j+1]=lst[j+1],lst[j]
            #desc
            if order=="descending" and lst[j]<lst[j+1]:
                lst[j+1],lst[j]=lst[j],lst[j+1]
    return lst

#input
n=int(input("Enter the no. of items in list:"))
lst=[]

for i in range(n):
    lst.append(int(input(f"Enter number{i+1}:")))

order=input("Enter order(ascending/descending:)")
print("Sorted list:",sort_fun(lst,order))
